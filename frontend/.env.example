# Used in production builds. In dev, Vite proxy handles /api automatically.
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME=App Name

# Formspree endpoint for the contact form (create a form at https://formspree.io
# pointed at devanr2911@gmail.com, then paste its endpoint URL here).
# Used by the dev server (client-side fetch). In production, api/contact.js
# runs on Vercel instead and reads the SAME url from a separate, non-VITE_
# server-side env var — add FORMSPREE_ENDPOINT (no VITE_ prefix) with this
# value in the Vercel project's Environment Variables too.
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xpqvryqb
